rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(orgId, uid) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid);
    }

    function memberDoc(orgId) {
      return get(memberPath(orgId, request.auth.uid));
    }

    function isMember(orgId) {
      return signedIn()
        && exists(memberPath(orgId, request.auth.uid))
        && memberDoc(orgId).data.status == "active"
        && memberDoc(orgId).data.role in ["manager", "driver"];
    }

    function isManager(orgId) {
      return isMember(orgId) && memberDoc(orgId).data.role == "manager";
    }

    function isManagerAfter(orgId) {
      return signedIn()
        && existsAfter(memberPath(orgId, request.auth.uid))
        && getAfter(memberPath(orgId, request.auth.uid)).data.status == "active"
        && getAfter(memberPath(orgId, request.auth.uid)).data.role == "manager";
    }

    function isDriver(orgId) {
      return isMember(orgId) && memberDoc(orgId).data.role == "driver";
    }

    function assignedTruckId(orgId) {
      return memberDoc(orgId).data.assignedTruckId;
    }

    function truckPath(orgId, truckDocId) {
      return /databases/$(database)/documents/organizations/$(orgId)/trucks/$(truckDocId);
    }

    function ownsTruck(orgId, data) {
      return isDriver(orgId)
        && data.truckId is int
        && memberDoc(orgId).data.activeTruckId == data.truckId
        && exists(truckPath(orgId, "truck_" + string(data.truckId)))
        && get(truckPath(orgId, "truck_" + string(data.truckId))).data.activeDriverUid == request.auth.uid
        && get(truckPath(orgId, "truck_" + string(data.truckId))).data.isShiftActive == true;
    }

    function matchingActiveMembership(data) {
      return signedIn()
        && data.uid == request.auth.uid
        && data.organizationId is string
        && data.role in ["manager", "driver"]
        && existsAfter(memberPath(data.organizationId, request.auth.uid))
        && getAfter(memberPath(data.organizationId, request.auth.uid)).data.status == "active"
        && getAfter(memberPath(data.organizationId, request.auth.uid)).data.role == data.role;
    }

    match /driver_invitations/{inviteCode} {
      // Invitation codes are unguessable, single-use capabilities. Claimed invitations
      // are visible only to their owning manager and the account that claimed them.
      allow get: if signedIn()
        && (resource.data.active == true
          || resource.data.uid == request.auth.uid
          || isManager(resource.data.organizationId));
      allow list: if false;
      allow create: if signedIn()
        && isManager(request.resource.data.organizationId)
        && request.resource.data.active == true
        && request.resource.data.uid == "";
      allow delete: if signedIn() && isManager(resource.data.organizationId);
      allow update: if signedIn() && (
        isManager(resource.data.organizationId)
        || (
          resource.data.active == true
          && resource.data.uid == ""
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.active == false
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["uid", "claimedAt", "active"])
        )
      );
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if request.auth.uid == uid
        && matchingActiveMembership(request.resource.data)
        && request.resource.data.keys().hasOnly([
          "uid", "organizationId", "role", "businessName",
          "displayName", "phone", "updatedAt"
        ]);
    }

    match /business_codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerUid == request.auth.uid
        && request.resource.data.active == true;
      allow update, delete: if isManager(resource.data.organizationId);
    }

    match /organizations/{orgId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow get: if isMember(orgId);
      allow list, delete: if false;
      allow update: if isManager(orgId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "businessName", "businessType", "ownerName", "contactPhone",
          "contactEmail", "address", "city", "state", "gstin", "status"
        ]);

      match /members/{uid} {
        allow get: if signedIn() && (
          request.auth.uid == uid || isManager(orgId)
        );
        allow list: if isManager(orgId);
        allow create: if signedIn() && request.auth.uid == uid && (
          (
            request.resource.data.role == "manager"
            && request.resource.data.status == "active"
            && getAfter(/databases/$(database)/documents/organizations/$(orgId)).data.ownerUid == uid
          )
          || (
            request.resource.data.role == "driver"
            && request.resource.data.status == "active"
            && getAfter(/databases/$(database)/documents/driver_invitations/$(request.resource.data.invitationId)).data.organizationId == orgId
            && getAfter(/databases/$(database)/documents/driver_invitations/$(request.resource.data.invitationId)).data.uid == uid
            && getAfter(/databases/$(database)/documents/driver_invitations/$(request.resource.data.invitationId)).data.active == false
            && getAfter(/databases/$(database)/documents/driver_invitations/$(request.resource.data.invitationId)).data.driverId == request.resource.data.driverId
          )
        );
        allow update: if (
          isManager(orgId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "assignedTruckId", "earlyLogoutEnabled", "name", "phone"
          ])
        ) || (
          isDriver(orgId)
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["activeTruckId"])
          && request.resource.data.activeTruckId is int
          && (
            (request.resource.data.activeTruckId > 0
              && getAfter(truckPath(orgId, "truck_" + string(request.resource.data.activeTruckId))).data.activeDriverUid == request.auth.uid
              && getAfter(truckPath(orgId, "truck_" + string(request.resource.data.activeTruckId))).data.isShiftActive == true)
            || (request.resource.data.activeTruckId == 0
              && resource.data.activeTruckId is int
              && resource.data.activeTruckId > 0
              && get(truckPath(orgId, "truck_" + string(resource.data.activeTruckId))).data.activeDriverUid == request.auth.uid
              && getAfter(truckPath(orgId, "truck_" + string(resource.data.activeTruckId))).data.activeDriverUid == "")
          )
        );
        allow delete: if isManager(orgId);
      }

      match /manager_secrets/{uid} {
        allow read: if signedIn() && request.auth.uid == uid && isManager(orgId);
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && isManagerAfter(orgId);
        allow delete: if isManager(orgId);
      }

      match /settings/{settingId} {
        allow read: if isMember(orgId);
        allow create, update: if isManagerAfter(orgId);
        allow delete: if isManager(orgId);
      }

      match /trucks/{truckId} {
        allow read: if isManager(orgId) || isDriver(orgId);
        allow create, delete: if isManager(orgId);
        allow update: if isManager(orgId) || (
          isDriver(orgId)
          && resource.data.id is int
          && (
            (resource.data.activeDriverUid == request.auth.uid
              && request.resource.data.activeDriverUid == request.auth.uid
              && request.resource.data.isShiftActive == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "currentLat", "currentLng", "currentSpeedKmh",
                "statusText", "lastUpdated", "driverName"
              ]))
            || ((!("activeDriverUid" in resource.data) || resource.data.activeDriverUid == "")
              && resource.data.isShiftActive != true
              && request.resource.data.activeDriverUid == request.auth.uid
              && request.resource.data.isShiftActive == true
              && getAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.activeTruckId == resource.data.id
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "activeDriverUid", "isShiftActive", "statusText", "lastUpdated"
              ]))
            || (resource.data.activeDriverUid == request.auth.uid
              && request.resource.data.activeDriverUid == ""
              && request.resource.data.isShiftActive == false
              && getAfter(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.activeTruckId != resource.data.id
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                "activeDriverUid", "isShiftActive", "statusText", "currentSpeedKmh", "lastUpdated"
              ]))
          )
        );
      }

      match /drivers/{driverId} {
        allow read: if isManager(orgId)
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if isManager(orgId);
        allow update: if isManager(orgId) || (
          signedIn()
          && resource.data.uid == ""
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["uid", "status", "name", "phone", "assignedTruckId"])
          && getAfter(/databases/$(database)/documents/driver_invitations/$(resource.data.invitationCode)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/driver_invitations/$(resource.data.invitationCode)).data.active == false
        );
        allow delete: if isManager(orgId);
      }

      match /truck_subscriptions/{truckId} {
        allow read: if isManager(orgId);
        // Client-side checkout is explicitly test-only. A real paid/active state must
        // be written by a trusted payment webhook/backend, never by the Android app.
        allow create, update: if isManager(orgId)
          && request.resource.data.mode in ["test", "legacy_import"]
          && (
            (request.resource.data.mode == "test"
              && request.resource.data.status == "test_active"
              && request.resource.data.amountPaise == 14900
              && request.resource.data.currency == "INR")
            || (request.resource.data.mode == "legacy_import"
              && request.resource.data.status == "legacy_active"
              && request.resource.data.amountPaise == 0)
          );
        allow delete: if isManager(orgId);
      }

      match /location_points/{pointId} {
        allow read: if isManager(orgId) || ownsTruck(orgId, resource.data);
        allow create: if isManager(orgId) || ownsTruck(orgId, request.resource.data);
        allow update, delete: if isManager(orgId);
      }

      match /stop_records/{stopId} {
        allow read: if isManager(orgId) || ownsTruck(orgId, resource.data);
        allow create: if isManager(orgId) || ownsTruck(orgId, request.resource.data);
        allow update, delete: if isManager(orgId);
      }

      match /attendance/{attendanceId} {
        allow read: if isManager(orgId) || ownsTruck(orgId, resource.data);
        allow create, update: if isManager(orgId) || ownsTruck(orgId, request.resource.data);
        allow delete: if isManager(orgId);
      }

      match /voice_delivery_notes/{noteId} {
        allow read: if isManager(orgId) || ownsTruck(orgId, resource.data);
        allow create: if isManager(orgId) || ownsTruck(orgId, request.resource.data);
        allow update, delete: if isManager(orgId);
      }

      match /delivery_proofs/{proofId} {
        allow read: if isManager(orgId) || ownsTruck(orgId, resource.data);
        allow create: if isManager(orgId) || ownsTruck(orgId, request.resource.data);
        allow update, delete: if isManager(orgId);
      }
    }

    // No catch-all allow rule: every unlisted collection and subcollection is denied.
  }
}
